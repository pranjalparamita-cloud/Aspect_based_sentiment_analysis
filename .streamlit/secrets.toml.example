# Copy this file to `secrets.toml` (same folder) for LOCAL testing,
# or paste these 3 lines into Streamlit Cloud → Manage app → Settings → Secrets.
# NEVER commit the real secrets.toml to GitHub!
GOOGLE_CLIENT_ID = "xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_REDIRECT_URI = "https://YOUR-APP-NAME.streamlit.app/"
