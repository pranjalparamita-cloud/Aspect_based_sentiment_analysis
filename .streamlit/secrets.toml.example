# Copy this file to secrets.toml for local testing.
# Never put real credentials in this example file or on GitHub.

GOOGLE_CLIENT_ID = "PASTE_YOUR_CLIENT_ID_IN_SECRETS_TOML_ONLY"
GOOGLE_CLIENT_SECRET = "PASTE_YOUR_CLIENT_SECRET_IN_SECRETS_TOML_ONLY"
GOOGLE_REDIRECT_URI = "https://YOUR-APP-NAME.streamlit.app/"